# 构建产物
bin/

# Python 字节码（里面会带着编译时的完整路径）
__pycache__/
*.py[cod]

# 打包输出和发布包（发布包放在 GitHub Releases）
*.zip
dist/

# tools\ 下载脚本的默认输出：语音模型、依赖包
tools/models/
tools/wheels/
tools/model-parts/
*.parts/

# 程序运行时在自己文件夹里生成的文件
上次设置.json
运行日志.txt
筛选记忆.txt
筛选记忆_清空前.txt
筛选记录.csv

# 编辑器 / 系统
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
